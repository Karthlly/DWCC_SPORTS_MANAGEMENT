@{
    ViewData["Title"] = "Verify Reset Code";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h3 class="card-title mb-4 text-center">Verify Reset Code</h3>
                    <p class="text-muted text-center mb-4">Enter the 6-digit code we sent to your email address.</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post" asp-action="VerifyResetCode" asp-controller="Home" id="codeForm">
                        <input type="hidden" name="email" value="@ViewBag.Email" />

                        <div class="mb-3">
                            <label for="resetCode" class="form-label">Reset Code</label>
                            <input type="text" class="form-control text-center" id="resetCode" name="resetCode" 
                                   placeholder="000000" maxlength="6" inputmode="numeric" required 
                                   style="font-size: 24px; letter-spacing: 10px;" />
                            <small class="text-muted d-block mt-2">Code expires in 15 minutes</small>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">Verify Code</button>
                        <a href="@Url.Action("ForgotPassword", "Home")" class="btn btn-secondary w-100">Back</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Only allow numbers in the code field
    document.getElementById('resetCode').addEventListener('keypress', function(e) {
        if (!/^\d$/.test(e.key)) {
            e.preventDefault();
        }
    });

    // Validate form on submit
    document.getElementById('codeForm').addEventListener('submit', function(e) {
        const code = document.getElementById('resetCode').value.trim();
        if (!/^\d{6}$/.test(code)) {
            alert('Please enter a valid 6-digit code.');
            e.preventDefault();
        }
    });
</script>

<style>
    .card {
        border: none;
        border-top: 4px solid #27ae60;
    }
</style>
