@{
    Layout = null;
    ViewData["Title"] = "Login - DWCC Sports Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- ✅ Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        /* Body & background */
        body {
            position: relative;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: "Segoe UI", sans-serif;
            margin: 0;
            /* Gradient background */
            background: linear-gradient(135deg, #0e4e2c, #00bfa5);
        }

            /* Background image overlay */
            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: url('/images/bg.jpg') center/cover no-repeat;
                opacity: 0.15; /* Low opacity */
                z-index: 0; /* Behind everything */
            }

        /* Login card on top */
        .login-card {
            position: relative; /* required for z-index */
            z-index: 1; /* make sure it is above the background image */
            background: white;
            border-radius: 1rem;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
            padding: 3rem;
            width: 100%;
            max-width: 420px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
        }

            /* Heading */
            .login-card h2 {
                color: #0e4e2c;
                font-weight: bold;
                margin-bottom: 1rem;
            }

        /* Input fields */
        .form-control {
            border-radius: 0.75rem;
            padding: 0.8rem;
            border: 1px solid #ced4da;
            transition: border 0.3s, box-shadow 0.3s;
        }

            .form-control:focus {
                border-color: #0e4e2c;
                box-shadow: 0 0 0 0.2rem rgba(14, 78, 44, 0.25);
                outline: none;
            }

        /* Login button */
        .btn-login {
            background: #0e4e2c;
            color: white;
            border-radius: 0.75rem;
            font-weight: bold;
            padding: 0.8rem;
            width: 100%;
            transition: all 0.3s;
            border: none;
        }

            .btn-login:hover {
                color: aliceblue;
                background: #0b3b20;
                transform: scale(1.03);
            }

        /* Alerts */
        .alert {
            border-radius: 0.75rem;
            font-size: 0.9rem;
        }

        /* Footer text */
        .login-card p {
            z-index: 1000;
            font-size: 0.85rem;
            color: #6c757d;
        }

        /* Optional error message */
        .error-message {
            color: red;
            margin-top: 0.5rem;
            font-size: 0.85rem;
        }
    </style>

</head>
<body>
    <div class="login-card">
        <h2 class="label">DWCC Halcons Management System</h2>
        <p class="text-muted mb-4">Please sign in to continue</p>

        <form method="post" asp-action="Index" asp-controller="Home">
            <div class="mb-3 text-start">
                <label for="username" class="form-label fw-semibold">Username</label>
                <input type="text" id="username" name="username" class="form-control" placeholder="Enter username" required />
            </div>

            <div class="mb-4 text-start">
                <label for="password" class="form-label fw-semibold">Password</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="Enter password" required />
            </div>

            <button type="submit" class="btn btn-login">Login</button>

            <div class="mt-3">
                <a href="@Url.Action("ForgotPassword", "Home")" class="text-decoration-none" style="color: #0e4e2c; font-weight: 500;">
                    <i class="bi bi-key me-2"></i>Forgot Password?
                </a>
            </div>
        </form>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger mt-3">@ViewBag.Error</div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success mt-3">@ViewBag.Success</div>
        }

        <!-- Forgot Password link -->
        <div class="mt-3 text-start">
            <a href="/Home/ForgotPassword" class="text-decoration-none" style="font-size: 0.9rem;">Forgot Password?</a>
        </div>

        <p class="mt-4 text-muted">© @DateTime.Now.Year DWCC Sports Management</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
