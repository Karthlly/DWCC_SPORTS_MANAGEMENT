        // Password Reset Flow
        [AllowAnonymous]
        [HttpGet]
        public IActionResult ForgotPassword()
        {
            return View();
        }

        [AllowAnonymous]
        [HttpPost]
        public async Task<IActionResult> ForgotPassword(string email)
        {
            if (string.IsNullOrEmpty(email))
            {
                ViewBag.Error = "Please enter a valid email address.";
                return View();
            }

            var user = _context.Users.FirstOrDefault(u => u.Email == email);
            if (user == null)
            {
                // Don't reveal if email exists for security reasons
                ViewBag.Success = "If an account with that email exists, a reset code has been sent.";
                return View();
            }

            // Generate 6-digit reset code
            var resetCode = new Random().Next(100000, 999999).ToString();
            var resetRecord = new PasswordReset
            {
                UserId = user.Id,
                ResetCode = resetCode,
                ExpiryTime = DateTime.UtcNow.AddMinutes(15),
                IsUsed = false
            };

            // Remove any existing unused reset codes for this user
            var oldResets = _context.PasswordResets.Where(p => p.UserId == user.Id && !p.IsUsed).ToList();
            _context.PasswordResets.RemoveRange(oldResets);

            _context.PasswordResets.Add(resetRecord);
            _context.SaveChanges();

            // Send email with reset code
            var emailService = HttpContext.RequestServices.GetRequiredService<IEmailService>();
            var emailSent = await emailService.SendPasswordResetCodeAsync(email, resetCode);

            if (emailSent)
            {
                // Redirect to verify code page
                return RedirectToAction("VerifyResetCode", new { email });
            }
            else
            {
                ViewBag.Error = "Failed to send reset code. Please try again later.";
                return View();
            }
        }

        [AllowAnonymous]
        [HttpGet]
        public IActionResult VerifyResetCode(string email)
        {
            if (string.IsNullOrEmpty(email))
                return RedirectToAction("Index");

            ViewBag.Email = email;
            return View();
        }

        [AllowAnonymous]
        [HttpPost]
        public IActionResult VerifyResetCode(string email, string resetCode)
        {
            if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(resetCode))
            {
                ViewBag.Error = "Please enter both email and reset code.";
                ViewBag.Email = email;
                return View();
            }

            var user = _context.Users.FirstOrDefault(u => u.Email == email);
            if (user == null)
            {
                ViewBag.Error = "Invalid email address.";
                ViewBag.Email = email;
                return View();
            }

            var validReset = _context.PasswordResets
                .FirstOrDefault(p => p.UserId == user.Id 
                    && p.ResetCode == resetCode 
                    && !p.IsUsed 
                    && p.ExpiryTime > DateTime.UtcNow);

            if (validReset == null)
            {
                ViewBag.Error = "Invalid or expired reset code.";
                ViewBag.Email = email;
                return View();
            }

            // Mark as used and proceed to reset password
            validReset.IsUsed = true;
            _context.SaveChanges();

            return RedirectToAction("ResetPassword", new { email, userId = user.Id });
        }

        [AllowAnonymous]
        [HttpGet]
        public IActionResult ResetPassword(string email, int userId)
        {
            // Verify user exists
            var user = _context.Users.FirstOrDefault(u => u.Id == userId && u.Email == email);
            if (user == null)
                return RedirectToAction("Index");

            ViewBag.Email = email;
            ViewBag.UserId = userId;
            return View();
        }

        [AllowAnonymous]
        [HttpPost]
        public IActionResult ResetPassword(int userId, string newPassword, string confirmPassword)
        {
            if (string.IsNullOrEmpty(newPassword) || string.IsNullOrEmpty(confirmPassword))
            {
                ViewBag.Error = "Please enter both password and confirmation.";
                ViewBag.UserId = userId;
                return View();
            }

            if (newPassword != confirmPassword)
            {
                ViewBag.Error = "Passwords do not match.";
                ViewBag.UserId = userId;
                return View();
            }

            if (newPassword.Length < 6)
            {
                ViewBag.Error = "Password must be at least 6 characters long.";
                ViewBag.UserId = userId;
                return View();
            }

            var user = _context.Users.FirstOrDefault(u => u.Id == userId);
            if (user == null)
            {
                ViewBag.Error = "User not found.";
                return View();
            }

            // Hash and update password
            var passwordHasher = new PasswordHasher<User>();
            user.Password = passwordHasher.HashPassword(user, newPassword);
            _context.SaveChanges();

            TempData["Success"] = "Your password has been reset successfully. Please log in with your new password.";
            return RedirectToAction("Index");
        }

        [HttpPost]
        public IActionResult SaveRubrics([FromBody] List<Rubric> rubrics)
        {
            if (rubrics == null || rubrics.Count == 0)
                return BadRequest("No data received.");

            // 1️⃣ Remove all existing rubrics
            var existingRubrics = _context.Rubrics.ToList();
            if (existingRubrics.Any())
            {
                _context.Rubrics.RemoveRange(existingRubrics);
                _context.SaveChanges(); // optional, can save after adding new ones
            }

            // 2️⃣ Add new rubrics
            foreach (var r in rubrics)
            {
                r.CreatedAt = DateTime.Now;
                r.UpdatedAt = DateTime.Now;
                _context.Rubrics.Add(r);
            }

            _context.SaveChanges();
            return Ok("Rubrics saved successfully!");
        }



        public IActionResult Roster(int? sportId = null)
        {
            // Get logged-in coach username from session
            var username = User.Identity.Name;

            var coach = _context.Coaches.FirstOrDefault(c => c.Username == username);
            if (coach == null)
            {
                TempData["Error"] = "Coach not found or session expired.";
                return RedirectToAction("Index");
            }

            // Get teams belonging to this coach
            var teams = _context.Teams
                .Include(t => t.Sport)
                .Where(t => t.CoachId == coach.Id) // <-- use coach.Id here
                .ToList();

            // Filter by sport if selected
            if (sportId.HasValue)
            {
                teams = teams.Where(t => t.SportId == sportId.Value).ToList();
            }

            // Get athletes under those teams
            var teamIds = teams.Select(t => t.TeamId).ToList();
            var athletes = _context.Athletes
                .Include(a => a.Team)
                .Include(a => a.Sport)
                .Where(a => a.TeamId != null && teamIds.Contains(a.TeamId.Value))
                .ToList();

            // Dropdown sports for this coach
            var sports = teams
     .Select(t => t.Sport)
     .Where(s => s != null)
     .Distinct()
     .ToList();


            ViewBag.Sports = sports;
            ViewBag.SelectedSport = sportId;
            ViewBag.Teams = teams;

            return View(athletes);
        }






