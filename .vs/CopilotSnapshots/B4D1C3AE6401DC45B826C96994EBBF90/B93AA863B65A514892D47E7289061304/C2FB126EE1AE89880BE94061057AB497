        [HttpPost]
        public async Task<IActionResult> EditCoach(int id, Coach updatedCoach, IFormFile? ImageFile)
        {
            var coach = await _context.Coaches.FindAsync(id);

            if (coach == null)
            {
                return NotFound();
            }

            // Update basic fields
            coach.FirstName = updatedCoach.FirstName;
            coach.LastName = updatedCoach.LastName;
            coach.Phone = updatedCoach.Phone;
            coach.Bio = updatedCoach.Bio;

            // Handle image upload if new image is provided
            if (ImageFile != null && ImageFile.Length > 0)
            {
                var uploadsFolder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/images/coaches");
                if (!Directory.Exists(uploadsFolder))
                    Directory.CreateDirectory(uploadsFolder);

                var fileName = $"{Guid.NewGuid()}{Path.GetExtension(ImageFile.FileName)}";
                var filePath = Path.Combine(uploadsFolder, fileName);

                using (var stream = new FileStream(filePath, FileMode.Create))
                {
                    await ImageFile.CopyToAsync(stream);
                }

                // Update image path
                coach.ImageUrl = $"~/images/coaches/{fileName}";
            }

            _context.Coaches.Update(coach);
            await _context.SaveChangesAsync();

            // Redirect back to the profile page
            return RedirectToAction("CoachProfile", new { id = coach.Id });
        }

        [HttpPost]
        public async Task<IActionResult> UploadMedicalInfo(int id, IFormFile MedicalFile)
        {
            if (MedicalFile == null || MedicalFile.Length == 0)
            {
                TempData["Error"] = "No file selected for upload.";
                return RedirectToAction("Roster", "Home");
            }

            var athlete = await _context.Athletes.FindAsync(id);
            if (athlete == null)
            {
                TempData["Error"] = "Athlete not found.";
                return RedirectToAction("Roster", "Home");
            }

            var imagesFolder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/images");
            if (!Directory.Exists(imagesFolder))
            {
                Directory.CreateDirectory(imagesFolder);
            }

            var fileName = Guid.NewGuid() + Path.GetExtension(MedicalFile.FileName);
            var filePath = Path.Combine(imagesFolder, fileName);
            using (var stream = new FileStream(filePath, FileMode.Create))
            {
                await MedicalFile.CopyToAsync(stream);
            }

            athlete.MedicalInfo = "/images/" + fileName;
            await _context.SaveChangesAsync();

            TempData["Success"] = "Medical Info uploaded successfully!";
            return RedirectToAction("Roster", "Home");
        }

