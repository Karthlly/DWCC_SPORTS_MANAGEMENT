        [HttpGet]
        public IActionResult GetDashboardData()
        {
            // Get logged-in coach's ID from claims
            var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrEmpty(userIdClaim))
            {
                return Json(new { error = "User not logged in." });
            }

            if (!int.TryParse(userIdClaim, out int coachId))
            {
                return Json(new { error = "Invalid user ID." });
            }

            // Get the coach record
            var coach = _context.Users.FirstOrDefault(u => u.Id == coachId);
            if (coach == null)
            {
                return Json(new { error = "Coach not found." });
            }

            // Get teams owned by this coach
            var teams = _context.Teams
                .Where(t => t.CoachId == coachId)
                .ToList();

            var teamIds = teams.Select(t => t.TeamId).ToList();

            // Get athletes belonging to these teams
            var athletes = _context.Athletes
                .Where(a => a.TeamId.HasValue && teamIds.Contains(a.TeamId.Value))
                .ToList();

            // Get all sports
            var sports = _context.Sports.ToList();

            // Prepare dashboard data
            var genderData = athletes
                .GroupBy(a => a.Gender)
                .Select(g => new { gender = g.Key, count = g.Count() })
                .ToList();

            var statusData = athletes
                .GroupBy(a => a.Status)
                .Select(s => new { status = s.Key, count = s.Count() })
                .ToList();

            var perTeam = athletes
                .GroupBy(a => a.TeamId)
                .Select(g => new
                {
                    teamId = g.Key,
                    teamName = teams.FirstOrDefault(t => t.TeamId == g.Key)?.TeamName,
                    count = g.Count()
                })
                .ToList();

            var perSport = athletes
                .GroupBy(a => a.SportId)
                .Select(g => new
                {
                    sportId = g.Key,
                    sportName = sports.FirstOrDefault(s => s.Id == g.Key)?.Name,
                    count = g.Count()
                })
                .ToList();

            // Return JSON for the dashboard
            return Json(new
            {
                gender = genderData,
                status = statusData,
                perTeam,
                perSport
            });
        }

