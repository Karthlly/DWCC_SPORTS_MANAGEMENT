            catch (Exception ex)
            {
                Debug.WriteLine("AddAthlete Exception: " + ex.ToString());
                TempData["Error"] = "Failed to add/update athlete: " + ex.Message;

                // Repopulate ViewBag before returning
                var username = User.Identity.Name;
                var coach = _context.Coaches.FirstOrDefault(c => c.Username == username);
