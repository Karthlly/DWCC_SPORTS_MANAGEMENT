                var result = await _context.SaveChangesAsync();
                Debug.WriteLine($"SaveChangesAsync result: {result}");

                string action = isExistingAthlete ? "assigned to team" : "added";
                TempData["Success"] = $"Athlete {targetAthlete.FirstName} {targetAthlete.LastName} {action} successfully!";
                return RedirectToAction("Roster");
