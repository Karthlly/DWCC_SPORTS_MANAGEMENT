        public IActionResult Attendance(int? sessionId)
        {
            var username = User.Identity.Name;

            // Get the logged-in coach
            var coach = _context.Coaches.FirstOrDefault(c => c.Username == username);
            if (coach == null)
            {
                TempData["Error"] = "Coach not found or session expired.";
                return RedirectToAction("Index");
            }

            // Get teams of this coach
            var coachTeams = _context.Teams
                .Where(t => t.CoachId == coach.Id)
                .ToList();

            var rubrics = _context.Rubrics
                .OrderBy(r => r.Order)
                .ToList();

            var distinctPoints = rubrics
                .Select(r => r.Points)
                .Distinct()
                .OrderByDescending(p => p)
                .ToList();

            // Pass teams to view for dropdown
            ViewBag.Sessions = _context.Sessions
                .Include(s => s.Team)
                .Where(s => coachTeams.Select(t => t.TeamId).Contains(s.TeamId))
                .ToList();

            ViewBag.SelectedSessionId = sessionId;
            ViewBag.DistinctPoints = distinctPoints;

            List<AthleteModel> athletes = new List<AthleteModel>();
            Dictionary<int, AttendanceStatus> existingAttendance = new Dictionary<int, AttendanceStatus>();

            if (sessionId.HasValue)
            {
                // Make sure the selected session belongs to this coach
                var selectedSession = _context.Sessions
                    .Include(s => s.Team)
                    .FirstOrDefault(s => s.SessionId == sessionId.Value && coachTeams.Select(t => t.TeamId).Contains(s.TeamId));

                if (selectedSession != null)
                {
                    int teamId = selectedSession.TeamId;

                    // Get athletes in this session's team
                    athletes = _context.Athletes
                        .Include(a => a.Team)
                        .Include(a => a.Sport)
                        .Where(a => a.TeamId == teamId)
                        .Select(a => new AthleteModel
                        {
                            AthleteId = a.AthleteId,
                            FirstName = a.FirstName,
                            LastName = a.LastName,
                            Gender = a.Gender,
                            Birthdate = a.Birthdate,
                            MedicalInfo = a.MedicalInfo,
                            TeamId = a.TeamId,
                            SportId = a.SportId,
                            Team = a.Team,
                            Sport = a.Sport
                        })
                        .ToList();

                    // Load existing attendance for this session
                    var attendanceRecords = _context.Attendance
                        .Where(a => a.SessionId == sessionId.Value)
                        .ToList();

                    // Build dictionary: AthleteId -> Status
                    foreach (var record in attendanceRecords)
                    {
                        existingAttendance[record.AthleteId] = record.Status;
                    }
                }
            }

            // Pass existing attendance to view
            ViewBag.ExistingAttendance = existingAttendance;

            return View(athletes);
        }






