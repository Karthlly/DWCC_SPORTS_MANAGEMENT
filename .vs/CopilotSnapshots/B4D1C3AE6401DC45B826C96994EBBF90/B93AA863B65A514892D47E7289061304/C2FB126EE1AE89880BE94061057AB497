        [HttpPost]
        public IActionResult SaveAttendance(int SessionId, Dictionary<int, string> Statuses)
        {
            if (SessionId == 0 || Statuses == null)
            {
                TempData["Error"] = "Invalid session or statuses.";
                return RedirectToAction("Attendance", new { sessionId = SessionId });
            }

            foreach (var entry in Statuses)
            {
                int athleteId = entry.Key;
                string statusStr = entry.Value;

                if (!Enum.TryParse<DWCCSportsManagement.Models.AttendanceStatus>(statusStr, out var status))
                {
                    status = DWCCSportsManagement.Models.AttendanceStatus.Present; // default
                }

                // Check if attendance exists
                var existing = _context.Attendance
                                       .FirstOrDefault(a => a.SessionId == SessionId && a.AthleteId == athleteId);

                if (existing != null)
                {
                    // Update existing
                    existing.Status = status;
                    _context.Attendance.Update(existing);
                }
                else
                {
                    // Insert new
                    var attendance = new DWCCSportsManagement.Models.AttendanceModel
                    {
                        SessionId = SessionId,
                        AthleteId = athleteId,
                        Status = status
                    };
                    _context.Attendance.Add(attendance);
                }
            }

            _context.SaveChanges();
            TempData["Success"] = "Attendance saved successfully!";
            return RedirectToAction("Attendance", new { sessionId = SessionId });
        }



