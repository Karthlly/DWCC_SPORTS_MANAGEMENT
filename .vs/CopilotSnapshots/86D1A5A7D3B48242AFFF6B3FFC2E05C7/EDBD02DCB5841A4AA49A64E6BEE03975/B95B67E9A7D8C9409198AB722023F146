@model List<DWCCSportsManagement.Models.Coach>
@{
    ViewData["Title"] = "Manage Coaches";
    bool showRolePanel = ViewContext.HttpContext.Request.Query["panel"] == "role";
    var searchName = ViewContext.HttpContext.Request.Query["searchName"];
}

<div class="container mt-5">
   

    <!-- Role Manager Panel -->
    <div id="roleManagerPanel" class="card p-4 shadow-sm" style="display:block";>
        <h2 class="mb-3">Role Manager</h2>
        <p class="mb-2 text-muted">Manage all user and coach accounts.</p>

        <!-- Filters + Search -->
        <form id="roleSearchForm" method="get" asp-action="ManageCoach" asp-controller="Admin" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="panel" value="role" />
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input class="form-control" placeholder="Search name, username, email" type="text" name="searchName" value="@searchName" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Role</label>
                <select class="form-select" name="roleFilter">
                    <option value="">All</option>
                    <option value="Admin" selected="@(ViewBag.SelectedRole == "Admin" ? "selected" : null)">Admin</option>
                    <option value="Manager" selected="@(ViewBag.SelectedRole == "Manager" ? "selected" : null)">Manager</option>
                    <option value="Coach" selected="@(ViewBag.SelectedRole == "Coach" ? "selected" : null)">Coach</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select class="form-select" name="statusFilter">
                    <option value="">All</option>
                    <option value="Active" selected="@(ViewBag.SelectedStatus == "Active" ? "selected" : null)">Active</option>
                    <option value="Inactive" selected="@(ViewBag.SelectedStatus == "Inactive" ? "selected" : null)">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Apply</button>
            </div>
        </form>

        <div class="d-flex flex-wrap justify-content-between mb-3">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addCoachModal">
                <i class="bi bi-plus-lg me-1"></i> Add User
            </button>
        </div>

        <!-- Alerts -->
        @if (!string.IsNullOrEmpty(TempData["Error"] as string))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Html.Raw(TempData["Error"])<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(TempData["Success"] as string))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @{
            var successMessage = TempData["SuccessMessage"] as string;
            var newUsername = TempData["NewCoachUsername"] as string;
            var newPassword = TempData["NewCoachPassword"] as string;
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>@successMessage</strong><br />
                @if (!string.IsNullOrEmpty(newUsername) && !string.IsNullOrEmpty(newPassword))
                {
                    <span>Username: <strong>@newUsername</strong></span><br />
                    <span>Password: <strong>@newPassword</strong></span>
                }
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Simplified Users Table -->
        <div class="table-responsive mb-4">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th style="width:120px">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.UsersOnly == null || ViewBag.UsersOnly.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted">No users found.</td></tr>
                    }
                    else
                    {
                        foreach (var u in ViewBag.UsersOnly)
                        {
                            <tr>
                                <td>@u.Name</td>
                                <td>@u.Username</td>
                                <td>@(u.Email ?? "-")</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editUserModal-@u.Id">Edit</button>
                                </td>
                            </tr>

                            <!-- Edit Modal: role + status -->
                            <div class="modal fade" id="editUserModal-@u.Id" tabindex="-1" aria-labelledby="editUserModalLabel-@u.Id" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="editUserModalLabel-@u.Id">Edit @u.Username</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <form method="post" asp-action="EditUserRole" asp-controller="Admin" class="mb-3">
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <div class="mb-2">
                                                    <label class="form-label">Role</label>
                                                    <select name="role" class="form-select">
                                                        <option value="Admin" selected="@(u.Role == "Admin" ? "selected" : null)">Admin</option>
                                                        <option value="Manager" selected="@(u.Role == "Manager" ? "selected" : null)">Manager</option>
                                                        <option value="Coach" selected="@(u.Role == "Coach" ? "selected" : null)">Coach</option>
                                                    </select>
                                                </div>
                                                <button type="submit" class="btn btn-primary">Save Role</button>
                                            </form>

                                            <form method="post" asp-action="ToggleUserStatus" asp-controller="Admin">
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <div class="mb-2">
                                                    <label class="form-label">Status</label><br />
                                                    @if (u.Status == "Active")
                                                    {
                                                        <span class="badge bg-success me-2">Active</span>
                                                        <button type="submit" class="btn btn-outline-danger btn-sm" @(u.Role == "Admin" ? "disabled" : "")>Deactivate</button>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary me-2">Inactive</span>
                                                        <button type="submit" class="btn btn-outline-success btn-sm">Activate</button>
                                                    }
                                                </div>
                                            </form>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Legacy Role Manager Table (kept for reference/actions) -->
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Password</th>
                        <th>Role</th>
                        <th>Source</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in ViewBag.AllAccounts)
                    {
                        <tr>
                            <td>@acc.Id</td>
                            <td>@acc.Username</td>
                            <td>@acc.FirstName</td>
                            <td>@acc.LastName</td>
                            <td>
                                @if (acc.Source == "User")
                                {
                                    <span>********</span>
                                    <br />
                                    <a href="#" class="text-primary" data-bs-toggle="modal" data-bs-target="#changePasswordModal-@acc.Id">Change Password</a>
                                }
                                else
                                {
                                    <span>Coach Account</span>
                                }
                            </td>
                            <td>@acc.Role</td>
                            <td>@acc.Source</td>
                            <td class="text-center">
                                @if (acc.Source == "User")
                                {
                                    <div class="d-flex justify-content-center align-items-center flex-wrap gap-1">
                                        <form asp-action="EditUserRole" asp-controller="Admin" method="post" class="d-flex align-items-center gap-1">
                                            <input type="hidden" name="id" value="@acc.Id" />
                                            <select name="role" class="form-select form-select-sm">
                                                <option value="Admin" selected="@(acc.Role == "Admin" ? "selected" : null)">Admin</option>
                                                <option value="Manager" selected="@(acc.Role == "Manager" ? "selected" : null)">Manager</option>
                                                <option value="Coach" selected="@(acc.Role == "Coach" ? "selected" : null)">Coach</option>
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                        </form>

                                        <form asp-action="ToggleUserStatus" asp-controller="Admin" method="post">
                                            <input type="hidden" name="id" value="@acc.Id" />

                                            @if (acc.Status == "Active")
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        @(acc.Role == "Admin" ? "disabled" : "")>
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-success">Activate</button>
                                            }
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Coach record</span>
                                }
                            </td>
                        </tr>

                        @* Modal for changing password *@
                        if (acc.Source == "User")
                        {
                            <div class="modal fade" id="changePasswordModal-@acc.Id" tabindex="-1" aria-labelledby="changePasswordModalLabel-@acc.Id" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form method="post" asp-action="ChangeUserPassword" asp-controller="Admin">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="changePasswordModalLabel-@acc.Id">Change Password for @acc.Username</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <input type="hidden" name="id" value="@acc.Id" />
                                                <div class="mb-3">
                                                    <label for="newPassword-@acc.Id" class="form-label">New Password</label>
                                                    <input type="password" class="form-control" id="newPassword-@acc.Id" name="newPassword" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label for="confirmPassword-@acc.Id" class="form-label">Confirm Password</label>
                                                    <input type="password" class="form-control" id="confirmPassword-@acc.Id" name="confirmPassword" required />
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary">Change Password</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Existing modals retained below -->
<div class="modal fade" id="addCoachModal" tabindex="-1" aria-labelledby="addCoachModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <form id="addCoachForm" method="post" asp-action="AddCoach" asp-controller="Admin">
                <div class="modal-header">
                    <h5 class="modal-title" id="addCoachModalLabel">Add New Coach</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="container-fluid">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label for="firstName" class="form-label">First Name</label>
                                <input type="text" class="form-control" id="firstName" name="FirstName" required />
                            </div>
                            <div class="col-12 col-md-6">
                                <label for="lastName" class="form-label">Last Name</label>
                                <input type="text" class="form-control" id="lastName" name="LastName" required />
                            </div>
                            <div class="col-12">
                                <label for="phone" class="form-label">Phone</label>
                                <input type="text" class="form-control" id="phone" name="Phone" required placeholder="Enter up to 11 digits" />
                            </div>
                            <div class="col-12">
                                <label for="role" class="form-label">Role</label>
                                <select class="form-select" id="role" name="Role" required>
                                    <option value="">-- Select Role --</option>
                                    <option value="Admin">Admin</option>
                                    <option value="Manager">Team Manager</option>
                                    <option value="Coach">Coach</option>
                                </select>
                            </div>
                        </div>
                        <!-- Hidden fields -->
                        <input type="hidden" name="ImageUrl" value="~/assets/coach.jpg" />
                        <input type="hidden" name="Bio" value="Fill up if applicable" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="reassignTeamsModal" tabindex="-1" aria-labelledby="reassignTeamsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-action="ReassignTeams" asp-controller="Admin">
                <div class="modal-header">
                    <h5 class="modal-title" id="reassignTeamsModalLabel">Reassign Teams</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="oldCoachId" name="OldCoachId" />

                    <div class="mb-3">
                        <label for="newCoachId" class="form-label">Select New Coach</label>
                        <select class="form-select" id="newCoachId" name="NewCoachId" required>
                            <option value="">-- Select Coach --</option>
                            @if (ViewBag.AllCoaches != null)
                            {
                                @foreach (var c in ViewBag.AllCoaches)
                                {
                                    if (c.Status == "Active")
                                    {
                                        <option value="@c.Id">@c.FirstName @c.LastName</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div id="teamsContainer" class="mb-3">
                        <label class="form-label">Teams to Reassign</label>
                    </div>

                </div>


                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Reassign Teams</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="newCoachModal" tabindex="-1" aria-labelledby="newCoachModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="newCoachModalLabel">New Coach Credentials</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Username:</strong> <span id="newCoachUsername"></span></p>
                <p><strong>Password:</strong> <span id="newCoachPassword"></span></p>
                <p class="text-muted fst-italic">Make sure to save these credentials!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@using System.Text.Json
<script>
    var coaches = @Html.Raw(ViewBag.CoachesJson);
</script>

<script>
     document.getElementById('addCoachForm').addEventListener('submit', function(e) {
        const firstName = document.getElementById('firstName').value.trim();
        const lastName = document.getElementById('lastName').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const nameRegex = /^[A-Za-z]+$/;
        if (!nameRegex.test(firstName)) { alert('First Name must contain letters only.'); e.preventDefault(); return; }
        if (!nameRegex.test(lastName)) { alert('Last Name must contain letters only.'); e.preventDefault(); return; }
        const phoneRegex = /^\d{11}$/;
        if (!phoneRegex.test(phone)) { alert('Phone must be exactly 11 digits and numeric.'); e.preventDefault(); return; }
    });

    document.addEventListener("DOMContentLoaded", function () {
        const toggle = document.getElementById("roleManagerToggle");
        const coachPanel = document.getElementById("coachPanel");
        const rolePanel = document.getElementById("roleManagerPanel");
        const heading = document.getElementById("manageCoachHeading");
        if (toggle) {
            toggle.checked = @showRolePanel.ToString().ToLower();
            toggle.addEventListener("change", function () {
                coachPanel.style.display = this.checked ? "none" : "block";
                rolePanel.style.display = this.checked ? "block" : "none";
                heading.style.display = this.checked ? "none" : "block";
            });
        }

        var tempData = @Html.Raw(TempData["ReassignTeams"] ?? "null");
        if (tempData) {
            var reassignData = tempData;
            document.getElementById("oldCoachId").value = reassignData.CoachId;
            var container = document.getElementById("teamsContainer");
            container.innerHTML = '';
            var label = document.createElement('label');
            label.classList.add('form-label', 'mb-2');
            label.textContent = "Teams to Reassign";
            container.appendChild(label);
            if (reassignData.Teams.length > 0) {
                reassignData.Teams.forEach(team => {
                    var div = document.createElement('div');
                    div.classList.add('list-group-item', 'mb-2', 'shadow-sm', 'rounded');
                    div.innerHTML = `<div><p>${team.TeamName}</p></div>`;
                    container.appendChild(div);
                });
            } else {
                container.innerHTML = `<p class="text-muted fst-italic">No teams found to reassign.</p>`;
            }
            var modal = new bootstrap.Modal(document.getElementById('reassignTeamsModal'));
            modal.show();
        }

        var username = '@TempData["NewCoachUsername"]';
        var password = '@TempData["NewCoachPassword"]';
        if(username && password) {
            document.getElementById("newCoachUsername").textContent = username;
            document.getElementById("newCoachPassword").textContent = password;
            var modal = new bootstrap.Modal(document.getElementById('newCoachModal'));
            modal.show();
        }
    });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
