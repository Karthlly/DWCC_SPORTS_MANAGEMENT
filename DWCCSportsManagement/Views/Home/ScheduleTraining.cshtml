@{
    ViewData["Title"] = "Training Sched - DWCC Sports Management System";
}

@model List<DWCCSportsManagement.Models.SessionModel>


<div class="container mt-5">
    <h1 class="mb-4 text-start">Training Schedule</h1>

    <div class="mb-4 text-end d-flex justify-content-end gap-2">
        <!-- Add Session Button -->
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addSessionModal">
            <i class="bi bi-plus-circle me-1"></i> Add Session
        </button>

        <!-- View Archived Sessions Button -->
        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#archivedSessionModal">
            <i class="bi bi-archive me-1"></i> View Archived Sessions
        </button>
    </div>


    <!-- Archived Sessions Modal -->
    <div class="modal fade" id="archivedSessionModal" tabindex="-1" aria-labelledby="archivedSessionModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title" id="archivedSessionModalLabel">
                        <i class="bi bi-archive me-2"></i> Archived Sessions
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Date & Time</th>
                                    <th>Team</th>
                                    <th>Description</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var archivedSessions = false;
                                }

                                @foreach (var session in Model)
                                {
                                    if (session.Status == "Archived")
                                    {
                                        archivedSessions = true;
                                        <tr>
                                            <td>@session.SessionId</td>
                                            <td>@session.DateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@session.Team.TeamName</td>
                                            <td>@session.Description</td>
                                            <td>@session.Location</td>
                                            <td>@session.Status</td>
                                            <td>
                                                <form method="post" asp-action="ActivateSession" asp-route-id="@session.SessionId">
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="bi bi-check-circle"></i> Activate
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }

                                @if (!archivedSessions)
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">No archived sessions</td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>



    <!-- Training Sessions Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Session ID</th>
                    <th scope="col">Date & Time</th>
                    <th scope="col">Team Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Location</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var hasActiveSessions = false;
                }

                @foreach (var session in Model)
                {
                    if (session.Status == "Active")
                    {
                        hasActiveSessions = true;
                        <tr>
                            <td>@session.SessionId</td>
                            <td>@session.DateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@session.Team.TeamName</td>
                            <td>@session.Description</td>
                            <td>@session.Location</td>
                            <td>@session.Status</td>
                            <td>
                                <form method="post" asp-action="ArchiveSession" asp-route-id="@session.SessionId">
                                    <button type="submit" class="btn btn-sm btn-danger">Archive</button>
                                </form>
                            </td>
                        </tr>
                    }
                }

                @if (!hasActiveSessions)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No active sessions</td>
                    </tr>
                }
            </tbody>


        </table>
    </div>
</div>

<!-- Add/Edit Session Modal -->
<div class="modal fade" id="addSessionModal" tabindex="-1" aria-labelledby="addSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addSessionModalLabel">Add/Edit Session</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form method="post" asp-action="AddSession">
                    <div class="mb-3">
                        <label for="sessionDateTime" class="form-label">Date & Time</label>
                        <input type="datetime-local" class="form-control" name="DateTime" required>
                    </div>

                    <div class="mb-3">
                        <label for="teamId" class="form-label">Team</label>
                        <select class="form-control" name="TeamId" required>
                            <option value="" disabled selected>Select a team</option>
                            @foreach (var team in ViewBag.TeamNames as List<TeamModel>)
                            {
                                <option value="@team.TeamId">@team.TeamName</option>
                            }
                        </select>

                    </div>


                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" name="Description" rows="3"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" class="form-control" name="Location">
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn add-session-save-btn">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    h1 {
        color: #0e4e2c !important;
    }

    .add-session-btn, .add-session-save-btn {
        background-color: #0e4e2c !important;
        color: white !important;
    }

        .add-session-btn:hover, .add-session-save-btn:hover {
            background-color: #0b3b20 !important;
        }

    table {
        border-radius: 0.75rem;
        overflow: hidden;
    }

    tbody tr:hover {
        background-color: rgba(0, 191, 165, 0.1);
    }

    .btn-sm {
        margin-right: 0.25rem;
    }
</style>

<script src="~/js/roster.js"></script>
