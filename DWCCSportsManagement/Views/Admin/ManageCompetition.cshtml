@model List<DWCCSportsManagement.Models.Competition>
@{
    ViewData["Title"] = "Competition Manager";
}

<div class="container-fluid">
    <h1>Competition Manager</h1>

    <!-- Add Competition Button -->
    <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addCompetitionModal">
        Add Competition
    </button>

    <!-- Competition Table -->
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Competition ID</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Venue</th>
                    <th>Start Date & Time</th>
                    <th>End Date & Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var comp in Model)
                {
                    <tr>
                        <td>@comp.CompetitionId</td>
                        <td>@comp.Name</td>
                        <td>@comp.Type</td>
                        <td>@comp.Venue</td>
                        <td>@comp.StartDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@comp.EndDate.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- Add Competition Modal -->
<div class="modal fade" id="addCompetitionModal" tabindex="-1" aria-labelledby="addCompetitionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addCompetitionForm" method="post" asp-action="AddCompetition" asp-controller="Admin">
                <div class="modal-header">
                    <h5 class="modal-title" id="addCompetitionModalLabel">Add New Competition</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <input type="text" class="form-control" name="Type" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Venue</label>
                        <input type="text" class="form-control" name="Venue" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Start Date & Time</label>
                        <input type="datetime-local" class="form-control" name="StartDate" id="startDate" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">End Date & Time</label>
                        <input type="datetime-local" class="form-control" name="EndDate" id="endDate" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Competition</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Styles -->
<link rel="stylesheet" href="~/css/manageteam.css" />
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />


<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

