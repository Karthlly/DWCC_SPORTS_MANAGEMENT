@model List<DWCCSportsManagement.Models.Competition>
@{
    ViewData["Title"] = "Competition Manager";
}

<div class="container-fluid">
    <h1>Competition Manager</h1>

    <!-- Add Competition Button -->
    <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addCompetitionModal">
        Add Competition
    </button>

    <!-- Competition Table -->
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Competition ID</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Venue</th>
                    <th>Start Date & Time</th>
                    <th>End Date & Time</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var comp in Model)
                {
                    <tr>
                        <td>@comp.CompetitionId</td>
                        <td>@comp.Name</td>
                        <td>@comp.Type</td>
                        <td>@comp.Venue</td>
                        <td>@comp.StartDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@comp.EndDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-1 edit-competition-btn"
                                    data-competitionid="@comp.CompetitionId"
                                    data-name="@comp.Name"
                                    data-type="@comp.Type"
                                    data-venue="@comp.Venue"
                                    data-startdate="@comp.StartDate.ToString("yyyy-MM-ddTHH:mm")"
                                    data-enddate="@comp.EndDate.ToString("yyyy-MM-ddTHH:mm")">
                                Edit
                            </button>

                            <button class="btn btn-sm btn-secondary view-teams-btn"
                                    data-competitionid="@comp.CompetitionId">
                                View
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- View Teams Modal -->
<div class="modal fade" id="viewTeamsModal" tabindex="-1" aria-labelledby="viewTeamsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewTeamsModalLabel">Teams Participating</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Team Name</th>
                            <th>Category</th>
                            <th>Division</th>
                        </tr>
                    </thead>
                    <tbody id="modalTeamList"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<!-- Edit Competition Modal -->
<div class="modal fade" id="editCompetitionModal" tabindex="-1" aria-labelledby="editCompetitionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="editCompetitionForm" method="post" asp-action="UpdateCompetition" asp-controller="TeamManager">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Competition</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="editCompetitionId" name="CompetitionId" />

                    <div class="mb-3">
                        <label class="form-label">Competition Name</label>
                        <input type="text" class="form-control" id="editCompetitionName" name="Name" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" id="editCompetitionType" name="Type" required>
                            <option value="" disabled>Select type</option>
                            <option value="local">Local</option>
                            <option value="regional">Regional</option>
                            <option value="national">National</option>
                            <option value="international">International</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Venue</label>
                        <input type="text" class="form-control" id="editCompetitionVenue" name="Venue" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Start Date</label>
                        <input type="datetime-local" class="form-control" id="editCompetitionStart" name="StartDate" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">End Date</label>
                        <input type="datetime-local" class="form-control" id="editCompetitionEnd" name="EndDate" required>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-outline-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Add Competition Modal -->
<div class="modal fade" id="addCompetitionModal" tabindex="-1" aria-labelledby="addCompetitionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addCompetitionForm">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Competition</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" name="Name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" name="Type" required>
                            <option disabled selected>Select type</option>
                            <option value="local">Local</option>
                            <option value="regional">Regional</option>
                            <option value="national">National</option>
                            <option value="international">International</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Venue</label>
                        <input type="text" class="form-control" name="Venue" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Start Date & Time</label>
                        <input type="datetime-local" class="form-control" name="StartDate" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">End Date & Time</label>
                        <input type="datetime-local" class="form-control" name="EndDate" required />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Competition</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Styles -->
<link rel="stylesheet" href="~/css/manageteam.css" />
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/main.min.css" rel="stylesheet" />

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

// ========================
// OPEN EDIT MODAL
// ========================
document.addEventListener("DOMContentLoaded", function () {
    const editButtons = document.querySelectorAll(".edit-competition-btn");
    const editModal = new bootstrap.Modal(document.getElementById('editCompetitionModal'));

    editButtons.forEach(btn => {
        btn.addEventListener("click", function () {
            document.getElementById("editCompetitionId").value = this.dataset.competitionid;
            document.getElementById("editCompetitionName").value = this.dataset.name;
            document.getElementById("editCompetitionType").value = this.dataset.type;
            document.getElementById("editCompetitionVenue").value = this.dataset.venue;
            document.getElementById("editCompetitionStart").value = this.dataset.startdate;
            document.getElementById("editCompetitionEnd").value = this.dataset.enddate;

            editModal.show();
        });
    });
});


// ========================
// VIEW PARTICIPATING TEAMS
// ========================
document.addEventListener("DOMContentLoaded", function () {
    const buttons = document.querySelectorAll(".view-teams-btn");
    const modal = new bootstrap.Modal(document.getElementById('viewTeamsModal'));
    const list = document.getElementById('modalTeamList');

    buttons.forEach(btn => {
        btn.addEventListener("click", function () {
            const id = this.dataset.competitionid;
            list.innerHTML = "";

            fetch(`/TeamManager/GetParticipantsByCompetition/${id}`)
                .then(res => res.json())
                .then(data => {
                    if (data.length === 0)
                        list.innerHTML = "<tr><td colspan='3' class='text-center'>No teams found</td></tr>";

                    data.forEach(p => {
                        list.innerHTML += `
                            <tr>
                                <td>${p.teamName}</td>
                                <td>${p.category || "N/A"}</td>
                                <td>${p.subCategory || "N/A"}</td>
                            </tr>`;
                    });

                    modal.show();
                });
        });
    });
});


// ========================
// ADD COMPETITION (AJAX)
// ========================
$(document).ready(function () {
    $("#addCompetitionForm").submit(function (e) {
        e.preventDefault();

        $.ajax({
            url: "/TeamManager/AddCompetition",
            method: "POST",
            data: $(this).serialize(),
            success: function (res) {
                if (!res.success) {
                    Swal.fire({
                        icon: "warning",
                        title: "Schedule Conflict",
                        text: res.message
                    });
                } else {
                    Swal.fire({
                        icon: "success",
                        title: "Success",
                        text: res.message
                    }).then(() => {
                        location.reload();
                    });
                }
            }
        });
    });
});

</script>
