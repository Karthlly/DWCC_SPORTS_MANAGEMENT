@model List<DWCCSportsManagement.Models.AthleteModel>

@{
    var teams = ViewBag.Teams as List<DWCCSportsManagement.Models.TeamModel> ?? new List<DWCCSportsManagement.Models.TeamModel>();
    var performances = ViewBag.Performances as List<DWCCSportsManagement.Models.PerformanceModel> ?? new List<DWCCSportsManagement.Models.PerformanceModel>();
}

<div class="container mt-5">
    <h1 class="mb-4">Athletes</h1>

    <button class="btn btn-warning mb-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
        <i class="bi bi-plus"></i>Import Athlete
    </button>
    <div class="modal fade" id="uploadModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Upload Athlete Excel File</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form action="/TeamManager/ImportAthletesJson"
                      method="post"
                      enctype="multipart/form-data">

                    <div class="modal-body">
                        <label>Select Excel File (.xlsx)</label>
                        <input type="file" name="uploadedFile" class="form-control" required />
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Upload</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>

                </form>

            </div>
        </div>
    </div>


    <div class="table-responsive">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="mb-3">
            <label for="athleteSearch" class="form-label">Search by Name or Student ID</label>
            <input type="text" id="athleteSearch" class="form-control" placeholder="Type student ID or full name...">
        </div>

        <table class="table table-bordered align-middle" id="athleteTable">
            <thead>
                <tr>
                    <th>Student Id</th>
                    <th>Full Name</th>
                    <th>Gender</th>
                    <th>Birthdate</th>
                    <th>Medical Info</th>
                    <th>Grades</th>
                    <th>Team</th>
                    <th>Sport</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var athlete in Model)
                {
                    if (athlete.Status == "Inactive")
                    {
                        continue; // Skip inactive athletes
                    }

                    <tr>
                        <td>@athlete.StudentId</td>
                        <td>@athlete.FirstName @athlete.LastName</td>
                        <td>@(athlete.Gender ?? "N/A")</td>
                        <td>@(athlete.Birthdate?.ToShortDateString() ?? "N/A")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(athlete.MedicalInfo))
                            {
                                <a href="@athlete.MedicalInfo" target="_blank" class="btn btn-sm btn-outline-primary">
                                    Show Medical Info
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(athlete.Grades))
                            {
                                <a href="@athlete.Grades" target="_blank" class="btn btn-sm btn-outline-success">
                                    Show Grades
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>

                        <td>
                            @if (!athlete.TeamId.HasValue)
                            {
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addTeamModal_@athlete.AthleteId">
                                    Add to Team
                                </button>

                                <!-- Modal -->
                                <div class="modal fade" id="addTeamModal_@athlete.AthleteId" tabindex="-1" aria-labelledby="addTeamModalLabel_@athlete.AthleteId" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="AssignTeam" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="addTeamModalLabel_@athlete.AthleteId">
                                                        Assign @athlete.FirstName @athlete.LastName to Team
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <input type="hidden" name="athleteId" value="@athlete.AthleteId" />

                                                    <div class="mb-3">
                                                        <label for="teamSelect_@athlete.AthleteId" class="form-label">Select Team</label>
                                                        <select class="form-select" id="teamSelect_@athlete.AthleteId" name="teamId" required>
                                                            <option value="">-- Select Team --</option>
                                                            @if (((List<DWCCSportsManagement.Models.TeamModel>)ViewBag.Teams)
                                                                                                                .Where(t => t.SportId == athlete.SportId)
                                                                                                                .Any())
                                                            {
                                                                foreach (var team in ((List<DWCCSportsManagement.Models.TeamModel>)ViewBag.Teams)
                                                                .Where(t => t.SportId == athlete.SportId))
                                                                {
                                                                    <option value="@team.TeamId">@team.TeamName</option>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <option disabled>No team for this sport</option>
                                                            }

                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Add to Team</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @(athlete.Team != null ? athlete.Team.TeamName : "N/A")
                            }
                        </td>

                        <td>@(athlete.Sport?.Name ?? "N/A")</td>
                        <td>
                            <button class="btn btn-primary btn-sm view-remarks-btn"
                                    data-athleteid="@athlete.AthleteId"
                                    data-bs-toggle="modal"
                                    data-bs-target="#remarksModal"
                                    title="View Remarks">
                                <i class="bi bi-eye-fill"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

<!-- Add Athlete Modal (Enhanced Layout) -->
<div class="modal fade" id="addAthleteModal" tabindex="-1" aria-labelledby="addAthleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-action="AddAthlete" asp-controller="TeamManager" enctype="multipart/form-data">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="addAthleteModalLabel">Add New Athlete</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <!-- First & Last Name -->
                        <div class="col-md-6">
                            <label class="form-label" for="FirstName">First Name</label>
                            <input type="text" class="form-control" id="FirstName" name="FirstName" placeholder="Enter first name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="LastName">Last Name</label>
                            <input type="text" class="form-control" id="LastName" name="LastName" placeholder="Enter last name" required />
                        </div>

                        <!-- Gender & Birthdate -->
                        <div class="col-md-6">
                            <label class="form-label" for="Gender">Gender</label>
                            <select class="form-select" id="Gender" name="Gender" required>
                                <option value="">Select gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="Birthdate">Birthdate</label>
                            <input type="date" class="form-control" id="Birthdate" name="Birthdate" />
                        </div>

                        <!-- Medical File & Grades File -->
                        <div class="col-md-6">
                            <label class="form-label" for="MedicalFile">Medical Info (PDF or Image)</label>
                            <input type="file" class="form-control" id="MedicalFile" name="MedicalFile" accept="application/pdf, image/*" required/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="GradesFile">Grades (PDF or Image)</label>
                            <input type="file" class="form-control" id="GradesFile" name="GradesFile" accept="application/pdf, image/*" required/>
                        </div>

                        <!-- Team & Sport -->
                        <div class="col-md-6">
                            <label class="form-label" for="teamSelect">Team</label>
                            <select class="form-select" id="teamSelect" name="TeamId" required>
                                <option value="">Select team</option>
                                @foreach (var team in teams.Where(t => t.Status == "Accepted"))
                                {
                                    <option value="@team.TeamId" data-sport="@team.Sport?.Name">@team.TeamName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="sportName">Sport</label>
                            <input type="text" id="sportName" name="SportName" class="form-control" readonly />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-plus-lg me-1"></i> Add Athlete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>



<!-- Remarks Modal -->
<div class="modal fade" id="remarksModal" tabindex="-1" aria-labelledby="remarksModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white bg-success">
                <h5 class="modal-title" id="remarksModalLabel">
                    <i class="bi bi-person-lines-fill me-2"></i> Athlete Remarks
                </h5>
                <button type="button" class="btn-close btn-close-dark" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-3">
                <!-- Athlete & Session Info -->
                <h5 id="athleteSessionInfo" class="fw-bold mb-3 text-center text-secondary"></h5>

                <!-- Remarks List -->
                <div class="mb-4">
                    <h6 class="mb-2"><i class="bi bi-journal-text me-2"></i> Remarks</h6>
                    <ul id="remarksList" class="list-group shadow-sm rounded overflow-hidden">
                        <!-- Filled dynamically via JS -->
                    </ul>
                </div>

                <!-- Attendance Section -->
                <div class="mb-4">
                    <h6 class="mb-2"><i class="bi bi-calendar-check me-2"></i> Attendance</h6>
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-bordered table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="text-center">Session Name</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody id="attendanceTableBody">
                                <!-- Filled dynamically via JS -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Scholarship Section -->
                <div class="mb-3">
                    <h6 class="mb-2"><i class="bi bi-award me-2"></i> Scholarship</h6>
                    <div id="scholarshipCard" class="card bg-success text-white shadow-sm" style="display:none;">
                        <div class="card-body d-flex justify-content-between align-items-center py-2 px-3">
                            <h6 class="mb-0">Scholarship Percentage</h6>
                            <p id="scholarshipPercentage" class="fs-5 fw-bold mb-0"></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Optional: custom CSS for better visuals -->
<style>
    #remarksList li {
        transition: background-color 0.2s ease;
    }

        #remarksList li:hover {
            background-color: rgba(0, 123, 255, 0.1);
        }

    #attendanceTableBody tr:hover {
        background-color: rgba(13, 110, 253, 0.1);
    }

    #scholarshipCard {
        border-left: 5px solid #ffc107;
    }

    .modal-body h5 i {
        color: #0d6efd;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>



@section Scripts {
    <script>

                document.getElementById('athleteSearch').addEventListener('keyup', function() {
                var searchValue = this.value.toLowerCase();
                var table = document.getElementById('athleteTable');
                var rows = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');

                Array.from(rows).forEach(function(row) {
                    var studentId = row.cells[0].innerText.toLowerCase();
                    var fullName = row.cells[1].innerText.toLowerCase();

                    if (studentId.includes(searchValue) || fullName.includes(searchValue)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });



        document.getElementById("teamSelect").addEventListener("change", function () {
            const sportName = this.selectedOptions[0].getAttribute("data-sport") || "";
            document.getElementById("sportName").value = sportName;
        });

        let ratingsChart; // Global variable for chart instance

                           document.querySelectorAll(".view-remarks-btn").forEach(button => {
                       button.addEventListener("click", function () {
                           console.log("clicked")
                           const athleteId = this.getAttribute("data-athleteid");

                           const remarksList = document.getElementById("remarksList");
                           const athleteSessionInfo = document.getElementById("athleteSessionInfo");
                           const tableBody = document.getElementById("attendanceTableBody");
                           const scholarshipCard = document.getElementById("scholarshipCard");
                           const scholarshipPercentage = document.getElementById("scholarshipPercentage");

                           remarksList.innerHTML = "";
                           tableBody.innerHTML = "";
                           scholarshipCard.style.display = "none";

                           // --- Fetch Remarks ---
                           fetch(`/TeamManager/GetRemarks?athleteId=${athleteId}`)
                               .then(response => response.json())
                               .then(data => {
                                    console.log("Remarks Response:", data); // <-- Add this 
                                   if (data.length === 0) {
                                       remarksList.innerHTML = "<li class='list-group-item text-muted'>No remarks available</li>";
                                       athleteSessionInfo.textContent = "";
                                   } else {
                                       athleteSessionInfo.textContent = `Remarks for ${data[0].athleteName}`;

                                       let totalRating = 0;
                                       let totalMax = 0;

                                       data.forEach(item => {
                                           // Display remarks
                                           const li = document.createElement("li");
                                           li.classList.add("list-group-item");
                                           li.innerHTML = `
                                               <strong>Session:</strong> ${item.sessionName} <br>
                                               <strong>Rating:</strong> ${item.rating} <br>
                                               <em>${item.remarks}</em>`;
                                           remarksList.appendChild(li);

                                           // Sum ratings for scholarship
                                           totalRating += parseFloat(item.rating || 0);
                                           totalMax += parseFloat(item.maxRating || 0);
                                       });

                                       // Show scholarship percentage if data exists
                                       if (totalMax > 0) {
                                           const percentage = ((totalRating / totalMax) * 100).toFixed(2);
                                           scholarshipPercentage.textContent = `${percentage}%`;
                                           scholarshipCard.style.display = "block";
                                       }
                                   }
                               });

                           // --- Fetch Attendance ---
                           fetch(`/TeamManager/GetAttendance?athleteId=${athleteId}`)
                               .then(response => response.json())
                               .then(data => {
                                   tableBody.innerHTML = "";

                                   if (data.length === 0) {
                                       tableBody.innerHTML = `
                                           <tr>
                                               <td colspan="2" class="text-center text-muted">No attendance records</td>
                                           </tr>`;
                                       return;
                                   }

                                   data.forEach(item => {
                                       const row = document.createElement("tr");
                                       row.innerHTML = `
                                           <td>${item.sessionName}</td>
                                           <td>${item.status}</td>
                                       `;
                                       tableBody.appendChild(row);
                                   });
                               });
                       });
                   });



    </script>

}
