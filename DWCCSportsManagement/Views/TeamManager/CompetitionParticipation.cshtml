@model CompetitionParticipationViewModel

<div class="container mt-5">
    <h1>Participate in a Competition</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Competition Cards -->
    <div class="row mt-4">
        @foreach (var comp in Model.Competitions)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-lg rounded-4 overflow-hidden">

                    <!-- Colored header -->
                    <div style="background-color: #0e4e2c; color: white; text-align: center; padding: 1rem;">
                        <h5 class="card-title mb-0">@comp.Name</h5>
                    </div>

                    <div class="card-body">
                        <p class="mb-2">
                            <span class="badge" style="background-color: #0e4e2c; color: white;">Type: @comp.Type</span>
                        </p>
                        <p class="mb-1"><i class="bi bi-geo-alt-fill me-2"></i>@comp.Venue</p>
                        <p class="mb-1"><i class="bi bi-calendar-event me-2"></i>Start: @comp.StartDate:yyyy-MM-dd</p>
                        <p class="mb-3"><i class="bi bi-calendar-event me-2"></i>End: @comp.EndDate:yyyy-MM-dd</p>
                    </div>

                    <div class="card-footer bg-transparent border-top-0 text-center pb-3">
                        <button class="btn participate-btn"
                                style="background-color: #0e4e2c; color: white;"
                                data-competitionid="@comp.CompetitionId">
                            Participate
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>



    <!-- Participants Table -->
    <h2 class="mt-5">Competition Participants</h2>
    <table class="table table-bordered table-striped table-hover mt-3">
        <thead>
            <tr>
                <th>Competition</th>
                <th>Team</th>
                <th>Results</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var comp in Model.Competitions)
            {
                var participants = Model.Participants
                .Where(p => p.CompetitionId == comp.CompetitionId)
                .ToList();

                foreach (var participant in participants)
                {
                    var team = Model.Teams.FirstOrDefault(t => t.TeamId == participant.TeamId);
                    var resultValue = string.IsNullOrEmpty(participant.Results) ? "Ongoing" : participant.Results;

                    <tr>
    <td>@comp.Name</td>
    <td>@team?.TeamName</td>
    <td>
        @if (participant.Status == "Completed")
        {
            <!-- Show input to enter standing -->
            <form method="post" asp-action="UpdateResult" asp-controller="TeamManager" class="d-flex gap-2">
                <input type="hidden" name="ParticipantId" value="@participant.ParticipantId" />
                <input type="hidden" name="CompetitionId" value="@participant.CompetitionId" />
                <input type="hidden" name="TeamId" value="@participant.TeamId" />

                                    <input type="text" name="results" class="form-control form-control-sm"
                                           placeholder="Enter standing e.g 1st, 2nd, 3rd" value="@participant.Results" />

                <button type="submit" class="btn btn-success btn-sm">Save</button>
            </form>
        }
        else
        {
            <!-- Just show the status text -->
            @participant.Results
        }
    </td>
    <td>
        <!-- Status dropdown remains for updating -->
        <form method="post" asp-action="UpdateStatus" asp-controller="TeamManager" class="d-flex gap-2">
    <input type="hidden" name="ParticipantId" value="@participant.ParticipantId" />
    <input type="hidden" name="CompetitionId" value="@participant.CompetitionId" />
    <input type="hidden" name="TeamId" value="@participant.TeamId" />

                                <select name="Status" class="form-select form-select-sm">
                                    <option value="">Select status</option>
                                    <option value="Processing" selected="@(participant.Status == "Processing")">Process</option>
                                    <option value="Ongoing" selected="@(participant.Status == "Ongoing")">Ongoing</option>
                                    <option value="Completed" selected="@(participant.Status == "Completed")">Completed</option>
                                </select>

    <button type="submit" class="btn btn-success btn-sm">Update</button>
</form>

    </td>
</tr>

                }
            }
        </tbody>
    </table>
</div>

<!-- Participate Modal -->
<div class="modal fade" id="participateModal" tabindex="-1" aria-labelledby="participateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Participate in Competition</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="participateForm" method="post" asp-action="ParticipateInCompetition" asp-controller="TeamManager">
                    <div class="mb-3">
                        <label for="competitionId" class="form-label">Competition ID</label>
                        <input type="text" class="form-control" id="competitionId" name="CompetitionId" readonly>
                    </div>
                    <div class="mb-3">
                        <label for="teamName" class="form-label">Team Name</label>
                        <select class="form-select" id="teamName" name="TeamId" required>
                            <option value="">Select Team</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var availableTeamsByCompetition = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AvailableTeamsByCompetition));

        document.addEventListener("DOMContentLoaded", function () {
            const buttons = document.querySelectorAll(".participate-btn");
            const modal = new bootstrap.Modal(document.getElementById('participateModal'));
            const competitionInput = document.getElementById('competitionId');
            const teamSelect = document.getElementById('teamName');

            buttons.forEach(btn => {
                btn.addEventListener("click", function () {
                    const compId = this.getAttribute("data-competitionid");
                    competitionInput.value = compId;

                    // Clear previous options
                    teamSelect.innerHTML = '<option value="">Select Team</option>';

                    // Populate dropdown with available teams
                    if (availableTeamsByCompetition[compId]) {
                        availableTeamsByCompetition[compId].forEach(team => {
                            const option = document.createElement('option');
                            option.value = team.TeamId;
                            option.text = team.TeamName;
                            teamSelect.appendChild(option);
                        });
                    }

                    modal.show();
                });
            });
        });
    </script>
}
